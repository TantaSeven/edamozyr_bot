@dp.message(lambda m: m.text == "📋 Мои заказы")
async def my_orders(message: types.Message):
    conn = sqlite3.connect('orders.db')
    cursor = conn.cursor()
    cursor.execute('SELECT id, order_text, status, created_at FROM orders WHERE user_id = ? ORDER BY id DESC LIMIT 10', (message.from_user.id,))
    orders = cursor.fetchall()
    conn.close()
    if not orders:
        await message.answer("📭 Заказов нет.")
        return
    text = "📋 Ваши заказы:\n\n"
    for o in orders:
        text += f"#{o[0]} | {o[2]} | {o[1][:30]}...\n"
    await message.answer(text)

