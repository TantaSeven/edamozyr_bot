@dp.message()
async def handle_order(message: types.Message):
    user_id = message.from_user.id
    text = message.text

    if user_id in ADMIN_IDS:
        if text == "📦 Новые заказы":
            orders = get_orders('новый')
            if not orders:
                await message.answer("Новых заказов нет.")
                return
            for o in orders[:5]:
                await message.answer(f"🆕 Заказ #{o[0]}\n{o[2]}\n{o[5]}\n\n/accept {o[0]}")
            return
        if text == "✅ Все заказы":
            orders = get_orders()
            await message.answer(f"Всего заказов: {len(orders)}")
            return
        if text == "📊 Статистика":
            orders = get_orders()
            new = len([o for o in orders if o[3] == 'новый'])
            await message.answer(f"📊 Новых: {new}\nВсего: {len(orders)}")
            return
        return

    if len(text) > 10:
        save_order(user_id, message.from_user.username or "Без username", text)
        await message.answer("✅ Заказ принят!")
        for admin_id in ADMIN_IDS:
            await bot.send_message(admin_id, f"🆕 Новый заказ!\n\n{text}")
    else:
        await message.answer("Нажмите «Сделать заказ».")

@dp.message(Command("accept"))
async def accept(message: types.Message):
    if message.from_user.id not in ADMIN_IDS:
        return
    try:
        order_id = int(message.text.split()[1])
        update_order_status(order_id, 'принят')
        await message.answer(f"✅ Заказ #{order_id} принят!")
    except:
        await message.answer("❌ /accept НОМЕР")

